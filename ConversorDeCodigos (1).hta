BC / 14 XS"},{"CODIGO_CNH":"NP49","CONVERSAO":"592A/594"},{"CODIGO_CNH":"P70040010","CONVERSAO":"6305 2RS"},{"CODIGO_CNH":"R6800040","CONVERSAO":"30216"},{"CODIGO_CNH":"TAJAA1244","CONVERSAO":"594"},{"CODIGO_CNH":"TJAA1242","CONVERSAO":"594 / 592 A"},{"CODIGO_CNH":"TUAA1243","CONVERSAO":"592 A"},{"CODIGO_CNH":"TYBJ44804","CONVERSAO":"88508"},{"CODIGO_CNH":"WAA4220","CONVERSAO":"501349 / 310"},{"CODIGO_CNH":"ZF0750117352","CONVERSAO":"802048 / 011"},{"CODIGO_CNH":"ZP0635501172","CONVERSAO":"802048"},{"CODIGO_CNH":"ZP0635501173","CONVERSAO":"802011"},{"CODIGO_CNH":"ZP0750117062","CONVERSAO":"819349 / 310"},{"CODIGO_CNH":"ZP0750117090","CONVERSAO":"501349"},{"CODIGO_CNH":"ZP0750117169","CONVERSAO":"37625 /"},{"CODIGO_CNH":"ZP0750117194","CONVERSAO":"15113 / 15245"},{"CODIGO_CNH":"ZP0750117195","CONVERSAO":"561301-503349/310"},{"CODIGO_CNH":"ZP0750117351","CONVERSAO":"88046 / 010"},{"CODIGO_CNH":"87044350","CONVERSAO":"GE30"},{"CODIGO_CNH":"84026027","CONVERSAO":"GNE50"},{"CODIGO_CNH":"756965","CONVERSAO":"GE35"},{"CODIGO_CNH":"757324","CONVERSAO":"GRA104-206"},{"CODIGO_CNH":"84991731","CONVERSAO":"NE45"},{"CODIGO_CNH":"212609","CONVERSAO":"GE40"},{"CODIGO_CNH":"84004118","CONVERSAO":"GE25"},{"CODIGO_CNH":"325103","CONVERSAO":"GRAE25"},{"CODIGO_CNH":"322360","CONVERSAO":"GRAE35"},{"CODIGO_CNH":"385424","CONVERSAO":"GE45"},{"CODIGO_CNH":"84998747","CONVERSAO":"GE50"},{"CODIGO_CNH":"9576041","CONVERSAO":"GRA104"},{"CODIGO_CNH":"325106","CONVERSAO":"GRAE30"},{"CODIGO_CNH":"80757325","CONVERSAO":"GRA100"},{"CODIGO_CNH":"9839347","CONVERSAO":"GRAE45"},{"CODIGO_CNH":"412441","CONVERSAO":"GRAE40"}]};
var META = {"CNH":"CNH (Case/New Holland)","BASE":"Base Geral (Cruzamento)","AGCO":"AGCO","RETENTORES":"Retentores","SEXTAVADOS":"Sextavados","LUK EMBREAGENS":"LUK Embreagens","BOCA DE MILHO":"Boca de Milho","TERMINAIS":"Terminais","ABAULADOS":"Rolamentos Abaulados","CORREIAS AGR":"Correias Agrícolas","DRAPER":"Draper / Multibelt","FIRESTONE":"Firestone (Molas)","ROTULAS":"Rótulas","MANG TERMINAIS":"Mangueiras / Terminais","RODA LIVRE":"Roda Livre","JACTO":"Jacto - Conversão Geral","EATON":"Eaton","CBT":"CBT","AGRALE":"Agrale","MASSEY":"Massey","CASE":"Case","CASE_Cana":"Case_Cana","VALTRA":"Valtra","JD_TRATORES":"John Deere (Tratores)","VENCETUDO":"Vencetudo","STARA_TRATORES":"Stara (Rolamentos)","PEER_TRATORES":"Peer (Tratores)","CONVERSOES_GERAIS":"Conversões Gerais (Várias Montadoras)","SEXTAVADO_MEDIDAS":"Sextavados - Medidas","PEER_ROLAMENTOS":"Peer (Rolamentos)","AUTOMOTIVA_LEVE_RODA":"Automotiva Leve - Roda","CORREIAS_TIMKEN":"Correias Timken","DRAPER_NOVO":"Draper - Multibelt (Novo)","CORRENTES_BOCA_MILHO":"Correntes Boca de Milho","CORRENTES_AGRICOLAS":"Correntes Agrícolas","TERMINAIS_GBR":"Terminais GBR (Catálogo)","RETENTORES_ARCA":"Retentores Arca","BOCA_MILHO_PDF":"Boca de Milho (Catálogo PDF)","JD":"JD (John Deere)","MOLAS_PNEUMATICAS":"Molas Pneumáticas","CORREIAS_AGR_NOVO":"Correias Agrícolas (Novo)","CNH_TRATORES":"CNH (Tratores)"};
var SHEET_ORDER = [];
for (var sk in DATA){ if (DATA.hasOwnProperty(sk)) SHEET_ORDER.push(sk); }

var activeSheet = null;
var MAX_PER_GROUP = 40;

function init(){
  var totalRows = 0;
  for (var i=0;i<SHEET_ORDER.length;i++){ totalRows += DATA[SHEET_ORDER[i]].length; }
  document.getElementById('totalCount').innerHTML = fmtNum(totalRows) + ' registros em ' + SHEET_ORDER.length + ' tabelas';
  renderFilters();
  document.getElementById('q').value = '';
  runSearch();
  document.getElementById('q').focus();
}

function fmtNum(n){
  var s = String(n);
  var out = '';
  var c = 0;
  for (var i=s.length-1;i>=0;i--){
    out = s.charAt(i) + out;
    c++;
    if (c % 3 === 0 && i !== 0) out = '.' + out;
  }
  return out;
}

function renderFilters(){
  var el = document.getElementById('filters');
  var htmlArr = [];
  for (var i=0;i<SHEET_ORDER.length;i++){
    var sheet = SHEET_ORDER[i];
    var label = META[sheet] ? META[sheet] : sheet;
    var cls = 'chip' + (activeSheet===sheet ? ' active' : '');
    htmlArr.push('<span class="'+cls+'" onclick="toggleSheet(\''+escapeAttr(sheet)+'\')">'+escapeHtml(label)+' ('+DATA[sheet].length+')</span>');
  }
  el.innerHTML = htmlArr.join('');
}

function toggleSheet(sheet){
  activeSheet = (activeSheet === sheet) ? null : sheet;
  renderFilters();
  runSearch();
}

function escapeHtml(s){
  s = String(s);
  s = s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  return s;
}
function escapeAttr(s){ return escapeHtml(s).replace(/\\/g,'\\\\'); }

function escapeRegex(s){
  return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function highlight(text, term){
  var out = escapeHtml(text);
  if (term){
    var esc = escapeRegex(term);
    var re = new RegExp('(' + esc + ')', 'gi');
    out = out.replace(re, '<span class="hlmark">$1</span>');
  }
  return out;
}

function objectValuesJoined(row){
  var parts = [];
  for (var k in row){ if (row.hasOwnProperty(k)) parts.push(row[k]); }
  return parts.join(' | ');
}

function normKey(s){
  return String(s).toUpperCase().replace(/[^A-Z0-9]/g, '');
}

function rowSignature(row){
  var parts = [];
  for (var k in row){ if (row.hasOwnProperty(k)) parts.push(normKey(row[k])); }
  return parts.join('|');
}

function searchOneTerm(term){
  var t = term.toLowerCase();
  var sheetsToSearch = activeSheet ? [activeSheet] : SHEET_ORDER;
  var bySheet = {};
  var order = [];
  var total = 0;
  for (var si=0; si<sheetsToSearch.length; si++){
    var sheet = sheetsToSearch[si];
    var rows = DATA[sheet];
    var matches = [];
    var seen = {};
    for (var ri=0; ri<rows.length; ri++){
      var hay = objectValuesJoined(rows[ri]).toLowerCase();
      if (hay.indexOf(t) !== -1){
        var sig = rowSignature(rows[ri]);
        if (seen.hasOwnProperty(sig)) continue;
        seen[sig] = true;
        matches.push(rows[ri]);
        if (matches.length > 3000) break;
      }
    }
    if (matches.length){
      bySheet[sheet] = matches;
      order.push(sheet);
      total += matches.length;
    }
  }
  return { total: total, bySheet: bySheet, order: order };
}

function buildRowCard(row, term){
  var fieldsHtml = [];
  for (var k in row){
    if (!row.hasOwnProperty(k)) continue;
    var v = row[k];
    var vStr = (v===null||v===undefined||v==='') ? '' : String(v);
    var isEmpty = (vStr === '');
    var lowerV = vStr.toLowerCase();
    var isHit = !isEmpty && lowerV.indexOf(term.toLowerCase()) !== -1;
    var cls = isEmpty ? 'v empty-v' : (isHit ? 'v hit' : 'v');
    var displayVal = isEmpty ? '&mdash;' : highlight(vStr, term);
    fieldsHtml.push('<div class="field"><div class="k">'+escapeHtml(k)+'</div><div class="'+cls+'">'+displayVal+'</div></div>');
  }
  return '<div class="rowcard">'+fieldsHtml.join('')+'</div>';
}

function onQChange(){
  runSearch();
}

function runSearch(){
  var raw = document.getElementById('q').value.replace(/^\s+|\s+$/g,'');
  var resultsEl = document.getElementById('results');
  var statusEl = document.getElementById('status');
  resultsEl.innerHTML = '';

  if (!raw){
    statusEl.innerHTML = '';
    resultsEl.innerHTML = '<div class="empty"><div class="big">&#8644;</div>Digite um ou mais codigos acima para ver a conversao.</div>';
    return;
  }

  var terms = raw.split(/[\n,;]+/);
  var cleanTerms = [];
  for (var i=0;i<terms.length;i++){
    var t = terms[i].replace(/^\s+|\s+$/g,'');
    if (t) cleanTerms.push(t);
  }

  var grandTotal = 0;
  var noMatchCount = 0;
  var htmlOut = [];

  for (var ti=0; ti<cleanTerms.length; ti++){
    var term = cleanTerms[ti];
    var res = searchOneTerm(term);
    grandTotal += res.total;
    if (res.total === 0) noMatchCount++;

    var bodyHtml = '';
    if (res.total === 0){
      bodyHtml = '<div class="empty" style="padding:16px; font-size:20px; font-weight:700; color:#ff8a3d;">Nao encontrado</div>';
    } else {
      var groupsArr = [];
      for (var gi=0; gi<res.order.length; gi++){
        var sheet = res.order[gi];
        var matches = res.bySheet[sheet];
        var cardsArr = [];
        var lim = Math.min(matches.length, MAX_PER_GROUP);
        for (var mi=0; mi<lim; mi++){
          cardsArr.push(buildRowCard(matches[mi], term));
        }
        var moreHtml = '';
        if (matches.length > MAX_PER_GROUP){
          moreHtml = '<div class="more">+ ' + (matches.length - MAX_PER_GROUP) + ' resultados adicionais nesta tabela - refine a busca para ver todos</div>';
        }
        var label = META[sheet] ? META[sheet] : sheet;
        groupsArr.push('<div class="group"><div class="group-title"><span class="n">'+matches.length+' resultado'+(matches.length>1?'s':'')+'</span><span>'+escapeHtml(label)+'</span></div>'+cardsArr.join('')+moreHtml+'</div>');
      }
      bodyHtml = groupsArr.join('');
    }

    var headCls = 'term-head' + (res.total===0 ? ' no-match' : '');
    htmlOut.push('<div class="term-block"><div class="'+headCls+'"><span class="term-count">'+res.total+' resultado'+(res.total===1?'':'s')+'</span><span class="badge">Busca</span><span class="term-text">'+escapeHtml(term)+'</span></div>'+bodyHtml+'</div>');
  }

  resultsEl.innerHTML = htmlOut.join('');

  if (cleanTerms.length === 1){
    statusEl.innerHTML = grandTotal===0 ? '' : '<b>'+grandTotal+'</b> resultado'+(grandTotal>1?'s':'')+' encontrado'+(grandTotal>1?'s':'');
  } else {
    var extra = noMatchCount>0 ? ' (<b>'+noMatchCount+'</b> sem resultado)' : '';
    statusEl.innerHTML = '<b>'+cleanTerms.length+'</b> codigos buscados - <b>'+grandTotal+'</b> resultados no total' + extra;
  }
}

function pad2(n){ return (n<10 ? '0' : '') + n; }

function nowStamp(){
  var d = new Date();
  return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate())+'_'+pad2(d.getHours())+pad2(d.getMinutes());
}

function nowDisplay(){
  var d = new Date();
  return pad2(d.getDate())+'/'+pad2(d.getMonth()+1)+'/'+d.getFullYear()+' '+pad2(d.getHours())+':'+pad2(d.getMinutes());
}

function safeCell(v){
  if (v===null || v===undefined || v==='') return '-';
  return String(v);
}

// Desenha uma tabela (estilo planilha) a partir da linha Y atual.
// Retorna a nova posicao Y apos a tabela. Quebra pagina automaticamente
// e repete o cabecalho da tabela na pagina seguinte.
function pdfDrawTable(doc, startY, headers, rows, marginLeft, pageWidth, pageHeight, maxRows){
  var fontSize = 10.5;
  var rowH = 20;
  var cellPad = 3;
  var usableW = pageWidth - marginLeft*2;

  doc.setFont('courier', 'normal');
  doc.setFontSize(fontSize);

  // largura de cada coluna com base no conteudo (amostra) e no cabecalho
  var n = headers.length;
  var widths = [];
  var i, r, txt, w;
  for (i=0;i<n;i++){
    w = doc.getTextWidth(String(headers[i])) + cellPad*2 + 4;
    var sampleLimit = Math.min(rows.length, 60);
    for (r=0;r<sampleLimit;r++){
      txt = safeCell(rows[r][headers[i]]);
      var tw = doc.getTextWidth(txt) + cellPad*2;
      if (tw > w) w = tw;
    }
    if (w < 70) w = 70;
    if (w > 260) w = 260;
    widths.push(w);
  }
  var total = 0;
  for (i=0;i<n;i++) total += widths[i];
  if (total > usableW){
    var scale = usableW / total;
    for (i=0;i<n;i++) widths[i] = widths[i]*scale;
  } else if (total < usableW){
    var extra = (usableW - total) / n;
    for (i=0;i<n;i++) widths[i] += extra;
  }

  var y = startY;

  function centerText(txt, colX, colW, baseY){
    var tw = doc.getTextWidth(txt);
    var tx = colX + (colW - tw)/2;
    if (tx < colX + 2) tx = colX + 2;
    doc.text(txt, tx, baseY);
  }

  function drawHeaderRow(){
    var x = marginLeft;
    doc.setFillColor(255,138,61);
    doc.setDrawColor(120,120,120);
    doc.setLineWidth(0.6);
    doc.setTextColor(30,20,10);
    doc.setFont('courier', 'bold');
    doc.rect(marginLeft, y, usableW, rowH, 'FD');
    for (i=0;i<n;i++){
      centerText(fitText(doc, String(headers[i]).toUpperCase(), widths[i]-cellPad*2), x, widths[i], y+rowH-6);
      if (i>0){ doc.line(x, y, x, y+rowH); }
      x += widths[i];
    }
    doc.setFont('courier', 'normal');
    doc.setTextColor(20,20,20);
    y += rowH;
  }

  function checkPageBreak(){
    if (y + rowH > pageHeight - 30){
      doc.addPage('a4', 'landscape');
      y = 34;
      drawHeaderRow();
    }
  }

  drawHeaderRow();

  var limit = Math.min(rows.length, maxRows);
  for (r=0;r<limit;r++){
    checkPageBreak();
    var x = marginLeft;
    var isNotFoundRow = !!rows[r].__notFound;
    if (isNotFoundRow){
      doc.setFillColor(255,235,220);
    } else if (r % 2 === 1){
      doc.setFillColor(250,250,250);
    } else {
      doc.setFillColor(255,255,255);
    }
    doc.setDrawColor(190,190,190);
    doc.setLineWidth(0.4);
    doc.rect(marginLeft, y, usableW, rowH, 'FD');
    for (i=0;i<n;i++){
      var cellTxt = safeCell(rows[r][headers[i]]);
      var isMsgCell = (cellTxt === 'Nao encontrado');
      if (isMsgCell){
        doc.setFont('courier', 'bold');
        doc.setTextColor(180,40,20);
      }
      centerText(fitText(doc, cellTxt, widths[i]-cellPad*2), x, widths[i], y+rowH-6);
      if (isMsgCell){
        doc.setFont('courier', 'normal');
        doc.setTextColor(20,20,20);
      }
      if (i>0){ doc.line(x, y, x, y+rowH); }
      x += widths[i];
    }
    y += rowH;
  }

  if (rows.length > maxRows){
    checkPageBreak();
    doc.setFont('courier', 'italic');
    doc.setTextColor(120,60,20);
    doc.text('+ ' + (rows.length - maxRows) + ' resultados adicionais nesta tabela (nao incluidos no PDF)', marginLeft+2, y+9);
    doc.setTextColor(20,20,20);
    doc.setFont('courier', 'normal');
    y += rowH;
  }

  return y + 6;
}

// Corta o texto e adiciona "..." se nao couber na largura da coluna
function fitText(doc, txt, maxW){
  if (doc.getTextWidth(txt) <= maxW) return txt;
  var out = txt;
  while (out.length > 1 && doc.getTextWidth(out + '...') > maxW){
    out = out.substring(0, out.length-1);
  }
  return out + '...';
}

// Gera um PDF real (arquivo .pdf baixado) com todas as conversoes
// pesquisadas no momento: todos os termos digitados, com todas as
// tabelas/linhas encontradas para cada um, em formato de tabela.
function gerarPDF(){
  var raw = document.getElementById('q').value.replace(/^\s+|\s+$/g,'');
  if (!raw){
    alert('Digite pelo menos um codigo e pesquise antes de gerar o PDF.');
    return;
  }

  var terms = raw.split(/[\n,;]+/);
  var cleanTerms = [];
  for (var i=0;i<terms.length;i++){
    var t = terms[i].replace(/^\s+|\s+$/g,'');
    if (t) cleanTerms.push(t);
  }
  if (!cleanTerms.length) return;

  var btn = document.getElementById('btnPdf');
  btn.disabled = true;
  var oldLabel = btn.innerHTML;
  btn.innerHTML = 'Gerando PDF...';

  setTimeout(function(){
    try{
      gerarPDFInterno(cleanTerms);
    } catch(e){
      alert('Erro ao gerar o PDF: ' + (e && e.message ? e.message : e));
    } finally {
      btn.disabled = false;
      btn.innerHTML = oldLabel;
    }
  }, 30);
}

function gerarPDFInterno(cleanTerms){
  var doc = new jspdf.jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
  var pageWidth = doc.internal.pageSize.getWidth();
  var pageHeight = doc.internal.pageSize.getHeight();
  var marginLeft = 24;
  var y = 40;
  var grandTotal = 0;

  var filtroLabel = activeSheet ? (META[activeSheet] ? META[activeSheet] : activeSheet) : 'Todas as tabelas';

  doc.setFont('courier', 'bold');
  doc.setFontSize(19);
  doc.setTextColor(20,20,20);
  doc.text('Relatorio de Conversao de Codigos', marginLeft, y);
  y += 20;

  doc.setFont('courier', 'normal');
  doc.setFontSize(11);
  doc.setTextColor(70,70,70);
  doc.text('Gerado em: ' + nowDisplay(), marginLeft, y); y += 15;
  doc.text('Tabela: ' + filtroLabel, marginLeft, y); y += 12;

  doc.setDrawColor(180,180,180);
  doc.line(marginLeft, y, pageWidth-marginLeft, y);
  y += 20;

  // Busca todos os termos e agrupa por tabela (sheet) de origem
  var perTerm = [];
  var sheetCounts = {};
  var sheetHeaders = {};
  for (var ti=0; ti<cleanTerms.length; ti++){
    var term = cleanTerms[ti];
    var res = searchOneTerm(term);
    grandTotal += res.total;
    perTerm.push({ term: term, res: res });
    for (var gi=0; gi<res.order.length; gi++){
      var sheet = res.order[gi];
      var matches = res.bySheet[sheet];
      sheetCounts[sheet] = (sheetCounts[sheet]||0) + matches.length;
      if (!sheetHeaders[sheet]){
        var hh = [];
        for (var k in matches[0]){ if (matches[0].hasOwnProperty(k)) hh.push(k); }
        sheetHeaders[sheet] = hh;
      }
    }
  }

  // tabela "principal": a que teve mais resultados no total
  var primarySheet = null, maxCount = -1;
  for (var s in sheetCounts){ if (sheetCounts[s] > maxCount){ maxCount = sheetCounts[s]; primarySheet = s; } }

  var primaryRows = [];
  var secondaryBlocks = []; // termos que bateram em outras tabelas alem da principal

  for (var i=0;i<perTerm.length;i++){
    var term = perTerm[i].term;
    var res = perTerm[i].res;
    var matchedPrimary = false;

    for (var gi=0; gi<res.order.length; gi++){
      var sheet = res.order[gi];
      var matches = res.bySheet[sheet];
      if (sheet === primarySheet){
        matchedPrimary = true;
        for (var m=0;m<matches.length;m++) primaryRows.push(matches[m]);
      } else {
        secondaryBlocks.push({ term: term, sheet: sheet, matches: matches });
      }
    }

    if (!matchedPrimary && primarySheet){
      var headers0 = sheetHeaders[primarySheet];
      var naoRow = { __notFound: true };
      for (var h=0; h<headers0.length; h++){
        naoRow[headers0[h]] = (h===0) ? term : 'Nao encontrado';
      }
      primaryRows.push(naoRow);
    }
  }

  if (primarySheet){
    var primaryLabel = META[primarySheet] ? META[primarySheet] : primarySheet;

    if (y > pageHeight - 80){ doc.addPage('a4','landscape'); y = 34; }

    doc.setFont('courier', 'bold');
    doc.setFontSize(13);
    doc.setTextColor(20,20,20);
    doc.text(primaryLabel, marginLeft, y);
    y += 14;

    y = pdfDrawTable(doc, y+5, sheetHeaders[primarySheet], primaryRows, marginLeft, pageWidth, pageHeight, 1000);
    y += 10;
  }

  // resultados adicionais que bateram em outras tabelas (estruturas diferentes)
  for (var b=0; b<secondaryBlocks.length; b++){
    var blk = secondaryBlocks[b];
    var label = META[blk.sheet] ? META[blk.sheet] : blk.sheet;

    if (y > pageHeight - 80){ doc.addPage('a4','landscape'); y = 34; }

    doc.setFont('courier', 'bold');
    doc.setFontSize(11.5);
    doc.setTextColor(180,90,20);
    doc.text('Codigo ' + blk.term + '  -  ' + label, marginLeft, y);
    y += 14;

    var hdrs = [];
    for (var k2 in blk.matches[0]){ if (blk.matches[0].hasOwnProperty(k2)) hdrs.push(k2); }
    y = pdfDrawTable(doc, y+5, hdrs, blk.matches, marginLeft, pageWidth, pageHeight, 500);
    y += 8;
  }

  if (!primarySheet && !secondaryBlocks.length){
    doc.setFont('courier', 'bold');
    doc.setFontSize(19);
    doc.setTextColor(150,40,40);
    doc.text('Nao encontrado', marginLeft, y+4);
    doc.setTextColor(20,20,20);
    y += 32;
  }


  doc.setFont('courier', 'normal');
  doc.setFontSize(10);
  doc.setTextColor(140,140,140);
  var pageCount = doc.internal.getNumberOfPages();
  for (var p=1; p<=pageCount; p++){
    doc.setPage(p);
    doc.text('Pagina ' + p + ' de ' + pageCount + '  -  Conversor de Codigos  -  Feito por Julio', marginLeft, pageHeight-12);
  }

  var filename = 'ConversaoDeCodigos_' + nowStamp() + '.pdf';
  var blob = doc.output('blob');

  if (navigator.msSaveOrOpenBlob){
    navigator.msSaveOrOpenBlob(blob, filename);
  } else {
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(function(){ URL.revokeObjectURL(url); }, 2000);
  }
}
</script>
</body>
</html>
