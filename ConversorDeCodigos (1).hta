<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>Conversor de Codigos - by Julio</title>
<HTA:APPLICATION
  APPLICATIONNAME="ConversorDeCodigos"
  ID="ConversorDeCodigos"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON="conversor_icone.ico"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
  SCROLL="yes"
  SELECTION="yes"
  NAVIGABLE="no"
/>
<style>
  html,body{ margin:0; padding:0; background:#14181c; }
  *{ box-sizing:border-box; }
  body{
    color:#e7ebee; font-family:Segoe UI,Arial,sans-serif; font-size:13px;
  }
  .wrap{ max-width:1100px; margin:0 auto; padding:20px 20px 50px; }
  .head{
    border-bottom:3px solid #ff8a3d; padding-bottom:12px; margin-bottom:18px;
  }
  .head h1{
    font-family:Consolas,monospace; font-size:19px; letter-spacing:0.5px; margin:0 0 4px 0;
    text-transform:uppercase; font-weight:700; color:#e7ebee;
  }
  .head h1 span{ color:#ff8a3d; }
  .head .count{ font-family:Consolas,monospace; font-size:11px; color:#93a1ac; text-transform:uppercase; letter-spacing:1px; }

  .searchbar{ margin-bottom:8px; }
  .searchbar textarea{
    width:100%; background:#1c2126; border:1px solid #333c44; color:#e7ebee;
    font-family:Consolas,monospace; font-size:14px; padding:12px 14px; border-radius:4px;
    line-height:1.5;
  }
  .hint{ font-family:Consolas,monospace; font-size:11px; color:#93a1ac; margin:6px 0 14px 0; }

  .filters{ margin-bottom:18px; }
  .chip{
    font-family:Consolas,monospace; font-size:11px; text-transform:uppercase; letter-spacing:0.5px;
    background:#1c2126; border:1px solid #333c44; color:#93a1ac;
    padding:5px 9px; border-radius:3px; cursor:pointer; margin:0 6px 6px 0; display:inline-block;
  }
  .chip.active{ background:#6b3a1d; border-color:#ff8a3d; color:#ff8a3d; }

  .status{ font-family:Consolas,monospace; font-size:12px; color:#93a1ac; margin-bottom:12px; min-height:16px; }
  .status b{ color:#ff8a3d; }

  .empty{ text-align:center; padding:50px 20px; color:#93a1ac; font-family:Consolas,monospace; font-size:13px; }
  .empty .big{ font-size:34px; margin-bottom:8px; }

  .term-block{ margin-bottom:28px; }
  .term-head{
    padding-bottom:8px; margin-bottom:10px; border-bottom:2px solid #333c44;
  }
  .term-head .badge{
    font-family:Consolas,monospace; font-size:10px; text-transform:uppercase; letter-spacing:0.5px;
    background:#ff8a3d; color:#1a1208; padding:3px 8px; border-radius:3px; font-weight:700;
  }
  .term-head .term-text{ font-family:Consolas,monospace; font-size:14px; color:#e7ebee; font-weight:700; margin-left:8px; }
  .term-head .term-count{ font-family:Consolas,monospace; font-size:11px; color:#93a1ac; float:right; }
  .term-head.no-match .badge{ background:#5a3030; color:#f0b0b0; }
  .term-head.no-match .term-count{ color:#c98080; }

  .group{ margin-bottom:22px; }
  .group-title{
    font-family:Consolas,monospace; font-size:11px; text-transform:uppercase; letter-spacing:1px;
    color:#ff8a3d; border-bottom:1px solid #333c44; padding-bottom:5px; margin-bottom:8px;
  }
  .group-title .n{ color:#93a1ac; float:right; text-transform:none; letter-spacing:0; }

  .rowcard{
    background:#1c2126; border:1px solid #333c44; border-radius:5px;
    padding:10px 12px; margin-bottom:7px;
  }
  .field{ display:inline-block; vertical-align:top; width:190px; margin:0 14px 6px 0; }
  .field .k{ font-family:Consolas,monospace; font-size:9px; text-transform:uppercase; letter-spacing:0.5px; color:#93a1ac; }
  .field .v{ font-family:Consolas,monospace; font-size:13px; color:#e7ebee; word-break:break-word; }
  .field .v.hit{ color:#ff8a3d; font-weight:700; background:#3a2a1c; padding:1px 4px; border-radius:3px; }
  .field .v.empty-v{ color:#4a545c; }

  .hlmark{ background:#ff8a3d; color:#1a1a1a; padding:0 1px; }

  .more{
    text-align:center; font-family:Consolas,monospace; font-size:11px; color:#93a1ac;
    padding:12px; border:1px dashed #333c44; border-radius:5px; margin-top:6px;
  }

  .footer{
    margin-top:34px; padding-top:14px; border-top:1px solid #333c44;
    text-align:center; font-family:Consolas,monospace; font-size:11px; color:#4a545c;
    letter-spacing:0.5px;
  }
  .footer span{ color:#ff8a3d; }

  .toolbar{ display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .btn-pdf{
    font-family:Consolas,monospace; font-size:12px; text-transform:uppercase; letter-spacing:0.5px;
    background:#ff8a3d; color:#1a1208; border:1px solid #ff8a3d; font-weight:700;
    padding:8px 14px; border-radius:4px; cursor:pointer;
  }
  .btn-pdf:hover{ background:#ffa768; }
  .btn-pdf:disabled{ background:#333c44; border-color:#333c44; color:#93a1ac; cursor:default; }

  #printHeader{ display:none; }

  @media print{
    html,body{ background:#fff !important; color:#111 !important; }
    .searchbar, .hint, .filters, .toolbar, .footer, .status{ display:none !important; }
    .wrap{ max-width:100%; padding:0; margin:0; }
    .head{ border-bottom:2px solid #333; }
    .head h1, .head h1 span{ color:#111 !important; }
    .head .count{ color:#444 !important; }

    #printHeader{
      display:block; font-family:Consolas,monospace; font-size:11px; color:#333;
      margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid #999;
    }
    #printHeader .line{ margin:2px 0; }

    .term-block{ page-break-inside:avoid; margin-bottom:18px; }
    .term-head{ border-bottom:1px solid #999; }
    .term-head .badge{ background:#ddd !important; color:#111 !important; }
    .term-head .term-text{ color:#111 !important; }
    .term-head .term-count{ color:#555 !important; }
    .term-head.no-match .badge{ background:#eee !important; color:#900 !important; }

    .group{ page-break-inside:avoid; }
    .group-title{ color:#111 !important; border-bottom:1px solid #999; }
    .group-title .n{ color:#555 !important; }

    .rowcard{
      background:#fff !important; border:1px solid #bbb !important;
      page-break-inside:avoid;
    }
    .field .k{ color:#666 !important; }
    .field .v{ color:#111 !important; }
    .field .v.hit{ background:#ffe2c2 !important; color:#111 !important; font-weight:700; }
    .field .v.empty-v{ color:#999 !important; }
    .hlmark{ background:#ffd9a8 !important; color:#111 !important; }

    .more{ border:1px dashed #999; color:#555; }
    .empty{ color:#555; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="head">
    <h1>Conversor <span>Original &rarr; Convertido</span></h1>
    <div class="count" id="totalCount"></div>
  </div>

  <div class="searchbar">
    <textarea id="q" rows="3" onkeyup="onQChange()">
    </textarea>
  </div>
  <div class="hint">Cole um ou varios codigos, um por linha (ou separados por virgula). Cada um e buscado separadamente em todas as tabelas. Use "Gerar PDF" para baixar um arquivo .pdf com todas as conversoes encontradas, em formato de tabela.</div>

  <div class="toolbar">
    <button type="button" class="btn-pdf" id="btnPdf" onclick="gerarPDF()">Gerar PDF</button>
  </div>

  <div class="filters" id="filters"></div>
  <div class="status" id="status"></div>

  <div id="printHeader"></div>

  <div id="results"></div>

  <div class="footer">Feito por <span>Julio</span></div>
</div>

<script type="text/javascript">
